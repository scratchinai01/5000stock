# 伺服器連接埠
PORT=3000

# 資料庫存放資料夾 (SQLite)。部署到 Cloud Run 等無狀態平台時，請掛載永久磁碟到此路徑，否則重啟會遺失資料。
DATA_DIR=./var

# 首次啟動建立的管理員帳號；未設定密碼時會產生隨機密碼並印在主控台
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# FinMind API Token (選填；設定後台股/台指期盤中可取即時快照)。也可在後台「報價管理」設定。
FINMIND_TOKEN=

# 設為 1 時完全不連外取報價 (離線展示/測試用，只使用手動報價)
QUOTES_OFFLINE=0

# 非 HTTPS 環境 (例如區網教室直接用 http://IP:3000) 的正式模式請設為 1，否則登入 cookie 無法寫入
INSECURE_COOKIE=0
